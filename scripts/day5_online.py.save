
#!/usr/bin/env python
"""Day 5 — nested online loop: ablation + distribution-shift experiment.

Trains the Day-4 contrastive base once, then evaluates online adaptation on a
query stream under two regimes (i.i.d. shuffled and block-sequential shift),
ablating the three Nested-Learning timescales:

  * static        — frozen base policy (no online updates)         [L0]
  * fast          — LinUCB head only                               [L1]
  * fast+mid      — LinUCB + EMA stabiliser                        [L1+L2]
  * full (nested) — LinUCB + EMA + periodic slow refit             [L1+L2+L3]

Outputs (dissertation Chapter 5):
  * a results table of mean reward / quality / cost per variant per regime,
  * an adaptation curve figure (running reward over the shift stream) showing
    the nested variant sustaining performance across task-family boundaries
    where the static policy dips.

Uses cached Qwen embeddings, so it runs in a few minutes.

Run:
    python scripts/day5_online.py
    python scripts/day5_online.py --epochs 100 --proj-dim 256 --w-bce 4.0
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

import tokenguard.routers  # noqa: F401
from tokenguard.config import load_config
from tokenguard.data.routerbench import RouterBench
from tokenguard.online.nested_router import NestedOnlineRouter
from tokenguard.online.shift import shift_stream, shuffled_stream, new_model_arrival_schedule
from tokenguard.routers.contrastive_router import ContrastiveRouter
from tokenguard.routers.embedding_cache import EmbeddingCache
from tokenguard.utils.logging import get_logger
from tokenguard.utils.seed import set_global_seed

VARIANTS = {
    "static":            dict(enable_fast=False, enable_mid=False, enable_slow=False, surprise_gate=False),
    "fast":              dict(enable_fast=True,  enable_mid=False, enable_slow=False, surprise_gate=False),
    "fast+mid":          dict(enable_fast=True,  enable_mid=True,  enable_slow=False, surprise_gate=False),
    "full (no surprise)":dict(enable_fast=True,  enable_mid=True,  enable_slow=True,  surprise_gate=False),
    "full (surprise)":   dict(enable_fast=True,  enable_mid=True,  enable_slow=True,  surprise_gate=True),
}


def build_encoder(kind: str):
    if kind == "qwen":
        from tokenguard.routers.qwen_encoder import QwenEncoder
        return QwenEncoder(), "Qwen__Qwen3-0.6B"
    from tokenguard.routers.embedding import SentenceEmbedder
    return SentenceEmbedder(), "all-MiniLM-L6-v2"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", default=None)
    parser.add_argument("--encoder", choices=["qwen", "minilm"], default="qwen")
    parser.add_argument("--epochs", type=int, default=100)
    parser.add_argument("--proj-dim", type=int, default=256)
    parser.add_argument("--temperature", type=float, default=0.1)
    parser.add_argument("--w-ss", type=float, default=0.2)
    parser.add_argument("--w-bce", type=float, default=4.0)
    parser.add_argument("--lr", type=float, default=0.02)
    parser.add_argument("--lambda-cost", type=float, default=0.5)
    parser.add_argument("--alpha", type=float, default=0.5)
    parser.add_argument("--slow-every", type=int, default=300)
    parser.add_argument("--arrival-model", default=None,
                        help="Model name to treat as a late arrival (default: last in pool).")
    parser.add_argument("--shift-granularity", choices=["task", "family"],
                        default="task",
                        help="'task' exposes full natural RouterBench shift.")
    args = parser.parse_args()

    cfg = load_config(args.config)
    set_global_seed(cfg.experiment.seed)
    logger = get_logger("day5", cfg.experiment.results_dir)

    parquet = (
        Path(cfg.data.processed_dir)
        / f"{Path(cfg.data.hf_filename).stem}.canonical.parquet"
    )
    bench = RouterBench.from_parquet(parquet)
    train, test = bench.split_random(cfg.data.test_size, cfg.experiment.seed)

    raw_encoder, enc_id = build_encoder(args.encoder)
    cache = EmbeddingCache(raw_encoder, enc_id,
                           cache_dir=Path(cfg.data.processed_dir) / "embeddings")

    # Train the contrastive base once (Day-4 best config).
    logger.info("Training contrastive base...")
    base = ContrastiveRouter(
        encoder=cache, proj_dim=args.proj_dim, temperature=args.temperature,
        w_sample_sample=args.w_ss, w_bce=args.w_bce, lr=args.lr,
        n_epochs=args.epochs, seed=cfg.experiment.seed,
    ).fit(train)

    streams = {
        "shuffled": shuffled_stream(test, seed=cfg.experiment.seed),
        "shift":    shift_stream(test, seed=cfg.experiment.seed,
                                 granularity=args.shift_granularity),
    }

    # New-model-arrival (C1): a genuinely valuable model is treated as a late
    # arrival — unavailable for the first half of the stream, then released.
    # We pick the arrival model as the one the oracle most often prefers on a
    # cost-aware basis (so discovering it actually matters), and report
    # POST-ARRIVAL quality, the only window where the effect can appear.
    arrival_stream = shuffled_stream(test, seed=cfg.experiment.seed + 7)
    if args.arrival_model:
        arrival_name = args.arrival_model
    else:
        perf_m = arrival_stream.perf_matrix()
        cost_m = arrival_stream.cost_matrix()
        rwd = perf_m - args.lambda_cost * (cost_m / max(cost_m.mean(), 1e-12))
        best_counts = np.bincount(rwd.argmax(axis=1), minlength=len(base.models_))
        arrival_name = base.models_[int(best_counts.argmax())]
    arrival_step, arrival_arm = new_model_arrival_schedule(
        arrival_stream, arrival_name, 0.5)
    logger.info("New-model-arrival: arm '%s' (idx %d) arrives at step %d",
                base.models_[arrival_arm], arrival_arm, arrival_step)

    rows = []
    curves: dict[str, dict] = {}
    arrival_curves: dict[str, dict] = {}
    for regime, stream in streams.items():
        for vname, flags in VARIANTS.items():
            router = NestedOnlineRouter(
                base=_clone_base(base), lambda_cost=args.lambda_cost,
                alpha=args.alpha, slow_update_every=args.slow_every,
                seed=cfg.experiment.seed, **flags,
            ).warm_start(train)
            out = router.run_stream(stream, record_every=200)
            rows.append({
                "regime": regime, "variant": vname,
                "mean_reward": out["mean_reward"],
                "mean_quality": out["mean_quality"],
                "mean_cost": out["mean_cost"],
            })
            if regime == "shift":
                curves[vname] = out
            logger.info("[%s/%s] reward=%.4f quality=%.4f cost=$%.6f",
                        regime, vname, out["mean_reward"],
                        out["mean_quality"], out["mean_cost"])

    # headline new-model-arrival regime (static vs full-surprise only)
    for vname in ["static", "full (surprise)"]:
        flags = VARIANTS[vname]
        router = NestedOnlineRouter(
            base=_clone_base(base), lambda_cost=args.lambda_cost,
            alpha=args.alpha, slow_update_every=args.slow_every,
            seed=cfg.experiment.seed, **flags,
        ).warm_start(train)
        out = router.run_stream(arrival_stream, record_every=200,
                                arrival_step=arrival_step, arrival_arm=arrival_arm)
        arrival_curves[vname] = out
        rows.append({
            "regime": "new-model-arrival", "variant": vname,
            "mean_reward": out["mean_reward"],
            "mean_quality": out["mean_quality"],
            "mean_cost": out["mean_cost"],
            "post_arrival_quality": out["post_arrival_quality"],
            "post_arrival_reward": out["post_arrival_reward"],
        })
        logger.info("[arrival/%s] reward=%.4f quality=%.4f",
                    vname, out["mean_reward"], out["mean_quality"])

    summary = pd.DataFrame(rows)
    out_csv = Path(cfg.experiment.results_dir) / "day5-online-summary.csv"
    summary.to_csv(out_csv, index=False)

    print("\n=== Day 5 summary (dissertation Table 4) ===")
    pivot = summary.pivot(index="variant", columns="regime",
                          values="mean_reward").reindex(list(VARIANTS))
    print(pivot.to_string(float_format=lambda v: f"{v:.4f}"))

    fig_path = _plot_shift_curves(curves, streams["shift"],
                                  Path(cfg.experiment.figures_dir))

    # Gate: under shift, the full surprise-gated router beats static (headline).
    shift = summary[summary.regime == "shift"].set_index("variant")["mean_reward"]
    static_r = shift["static"]
    nested_r = shift["full (surprise)"]
    delta = nested_r - static_r
    print(f"\nShift regime — static reward={static_r:.4f}, "
          f"full (surprise) reward={nested_r:.4f}, delta=+{delta:.4f}")

    # New-model-arrival headline (post-arrival window only)
    arr = summary[summary.regime == "new-model-arrival"].set_index("variant")
    a_static_q = arr.loc["static", "post_arrival_quality"]
    a_online_q = arr.loc["full (surprise)", "post_arrival_quality"]
    print(f"New-model-arrival (post-arrival) — static quality={a_static_q:.4f}, "
          f"online quality={a_online_q:.4f}, gain=+{a_online_q - a_static_q:.4f}")

    ok = nested_r > static_r
    print(f"  [{'PASS' if ok else 'FAIL'}] [G1] full (surprise) > static under shift")
    if ok:
        print(f"\nDAY 5 GATE: PASS — figure: {fig_path}")
        print("Next: Day 6 — OpenAI-compatible proxy + telemetry.")
        return 0
    print("\nDAY 5 GATE: FAIL — online adaptation did not beat static under shift; "
          "try --alpha 1.0 or --slow-every 300.")
    return 1


def _clone_base(base: ContrastiveRouter) -> ContrastiveRouter:
    """Shallow clone with copied learned params (so each variant starts fresh)."""
    import copy

    clone = copy.copy(base)
    clone.P_ = base.P_.copy()
    clone.E_ = base.E_.copy()
    clone.a_ = base.a_.copy()
    clone.b_ = base.b_.copy()
    return clone


def _plot_shift_curves(curves, shift_stream_bench, figures_dir: Path) -> Path:
    figures_dir.mkdir(parents=True, exist_ok=True)
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(13, 5.0), dpi=150)

    # left: running mean reward over the stream
    for vname, out in curves.items():
        style = dict(linewidth=2.2) if vname == "full-nested" else dict(linewidth=1.3, alpha=0.85)
        ax1.plot(out["trace_steps"], out["trace_reward"], label=vname, **style)
    ax1.set_xlabel("Stream position (queries seen)")
    ax1.set_ylabel("Running mean reward (window=200)")
    ax1.set_title("Online adaptation under task-level shift")
    ax1.legend(loc="lower right", fontsize=9)
    ax1.grid(alpha=0.25)

    # right: cumulative reward gap vs static (the headline separation)
    if "static" in curves:
        base_steps = curves["static"]["trace_steps"]
        base_rew = np.array(curves["static"]["trace_reward"])
        for vname, out in curves.items():
            if vname == "static":
                continue
            rew = np.array(out["trace_reward"])
            n = min(len(rew), len(base_rew))
            gap = np.cumsum(rew[:n] - base_rew[:n])
            style = dict(linewidth=2.2) if vname == "full-nested" else dict(linewidth=1.3, alpha=0.85)
            ax2.plot(base_steps[:n], gap, label=f"{vname} − static", **style)
        ax2.axhline(0, color="grey", linewidth=0.8)
        ax2.set_xlabel("Stream position (queries seen)")
        ax2.set_ylabel("Cumulative reward advantage over static")
        ax2.set_title("Reward gained by online adaptation")
        ax2.legend(loc="upper left", fontsize=9)
        ax2.grid(alpha=0.25)

    fig.tight_layout()
    out = figures_dir / "day5-shift-adaptation.png"
    fig.savefig(out)
    plt.close(fig)
    return out


if __name__ == "__main__":
    raise SystemExit(main())
